# ==============================================================================
# AgencyOS — Environment Configuration Template
# ==============================================================================
# Copy this file to .env or .env.local to configure your environment.
# NEVER commit real secrets or .env.local to source control.
#
# By default, AgencyOS runs in standalone "demo" mode with zero configuration needed.
# ==============================================================================

# Application Settings
VITE_APP_NAME="AgencyOS"

# Authentication & Backend Provider: "demo" | "firebase" | "supabase"
# - "demo": Zero-config client-side authentication with localStorage persistence.
# - "firebase": Uses Google Firebase Authentication.
# - "supabase": Uses Supabase Authentication & Database.
VITE_AUTH_PROVIDER="firebase"

# ------------------------------------------------------------------------------
# Firebase Configuration (Required only if VITE_AUTH_PROVIDER=firebase)
# Get these values from your Firebase Project Settings -> General -> Your apps
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY="AIzaSyCbjizDkQeLMk1oS3lvg0wId_XCl98r10k"
VITE_FIREBASE_AUTH_DOMAIN="agencyos-23a1d.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="agencyos-23a1d"
VITE_FIREBASE_STORAGE_BUCKET="agencyos-23a1d.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="122602227513"
VITE_FIREBASE_APP_ID="1:122602227513:web:8ad13f744577a978b6cae8"
VITE_FIREBASE_MEASUREMENT_ID="G-PXW3Z1CEWY"

# ------------------------------------------------------------------------------
# Supabase Configuration (Required only if VITE_AUTH_PROVIDER=supabase)
# Get these values from your Supabase Project Settings -> API
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# ------------------------------------------------------------------------------
# Custom API Base URL (Optional, for custom REST/GraphQL backend)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=""